{
  "name": "vue-git-stats",
  "version": "0.1.0",
  "description": "Beautiful GitHub/GitLab contribution graphs and stats for Vue 3",
  "type": "module",
  "main": "./dist/vue-git-stats.umd.js",
  "module": "./dist/vue-git-stats.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue-git-stats.es.js",
      "require": "./dist/vue-git-stats.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "templates",
    "cli"
  ],
  "bin": {
    "vue-git-stats": "./cli/init.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0"
  }
}
